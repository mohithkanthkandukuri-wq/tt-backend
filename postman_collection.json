{
  "info": {
    "_postman_id": "findit-plus-api-collection",
    "name": "FindIt+ Lost and Found Management System API",
    "description": "Complete REST API collection for FindIt+ campus recovery portal.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Student Alex\",\n  \"email\": \"alex.student@findit.edu\",\n  \"password\": \"Student@123\",\n  \"phone\": \"+1-555-0199\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@findit.edu\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@findit.edu\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex J. Updated\",\n  \"phone\": \"+1-555-9988\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Browse / Search Items",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/items?query=calculator&reportType=FOUND&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["items"],
              "query": [
                { "key": "query", "value": "calculator" },
                { "key": "reportType", "value": "FOUND" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Recent Items",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/items/recent", "host": ["{{baseUrl}}"], "path": ["items", "recent"] }
          }
        },
        {
          "name": "Get Item By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/items/1", "host": ["{{baseUrl}}"], "path": ["items", "1"] }
          }
        },
        {
          "name": "Get My Reported Items",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/items/my?page=0&size=10", "host": ["{{baseUrl}}"], "path": ["items", "my"] }
          }
        },
        {
          "name": "Create Lost or Found Report",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Graphing Calculator TI-84\",\n  \"description\": \"Black graphing calculator left on desk in Room 302.\",\n  \"category\": \"Electronics\",\n  \"reportType\": \"FOUND\",\n  \"location\": \"Engineering Bldg Room 302\",\n  \"incidentDate\": \"2026-10-12\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/items", "host": ["{{baseUrl}}"], "path": ["items"] }
          }
        },
        {
          "name": "Update Item Report",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Graphing Calculator TI-84 Plus CE\",\n  \"description\": \"Updated description with blue cover.\",\n  \"category\": \"Electronics\",\n  \"reportType\": \"FOUND\",\n  \"location\": \"Engineering Bldg Room 302\",\n  \"incidentDate\": \"2026-10-12\",\n  \"status\": \"OPEN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/items/1", "host": ["{{baseUrl}}"], "path": ["items", "1"] }
          }
        },
        {
          "name": "Mark Item as Returned",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/items/1/return", "host": ["{{baseUrl}}"], "path": ["items", "1", "return"] }
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/items/1", "host": ["{{baseUrl}}"], "path": ["items", "1"] }
          }
        }
      ]
    },
    {
      "name": "Claims",
      "item": [
        {
          "name": "Submit Claim",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"This calculator has my initials 'MJ' engraved on the upper battery compartment.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/items/1/claims", "host": ["{{baseUrl}}"], "path": ["items", "1", "claims"] }
          }
        },
        {
          "name": "Get My Claims",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/claims/my", "host": ["{{baseUrl}}"], "path": ["claims", "my"] }
          }
        },
        {
          "name": "Get Claim By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/claims/1", "host": ["{{baseUrl}}"], "path": ["claims", "1"] }
          }
        },
        {
          "name": "Approve Claim",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewMessage\": \"Ownership verified. Please meet at Central Security Desk with Student ID.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/claims/1/approve", "host": ["{{baseUrl}}"], "path": ["claims", "1", "approve"] }
          }
        },
        {
          "name": "Reject Claim",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reviewMessage\": \"Identifying markings did not match the recovered item.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/claims/1/reject", "host": ["{{baseUrl}}"], "path": ["claims", "1", "reject"] }
          }
        },
        {
          "name": "Cancel Claim",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/claims/1/cancel", "host": ["{{baseUrl}}"], "path": ["claims", "1", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications", "host": ["{{baseUrl}}"], "path": ["notifications"] }
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications/unread-count", "host": ["{{baseUrl}}"], "path": ["notifications", "unread-count"] }
          }
        },
        {
          "name": "Mark All As Read",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/notifications/read-all", "host": ["{{baseUrl}}"], "path": ["notifications", "read-all"] }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Admin Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] }
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        },
        {
          "name": "Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/users/2/role", "host": ["{{baseUrl}}"], "path": ["admin", "users", "2", "role"] }
          }
        },
        {
          "name": "Get All Items (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/items", "host": ["{{baseUrl}}"], "path": ["admin", "items"] }
          }
        },
        {
          "name": "Get All Claims (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/claims", "host": ["{{baseUrl}}"], "path": ["admin", "claims"] }
          }
        }
      ]
    }
  ]
}
