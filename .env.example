# ==============================================================
# FindIt+ Backend Environment Configuration Template
# Copy this file to .env or set system environment variables
# ==============================================================

# Database Configuration (MySQL 8.0+)
DB_URL=jdbc:mysql://localhost:3306/lost_found_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password_here

# Security & JWT Configuration
JWT_SECRET=your_base64_or_hex_encoded_secret_key_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# File Upload Storage Directory
APP_UPLOAD_DIR=uploads

# Allowed Frontend Origins for CORS
FRONTEND_URL=http://localhost:5173,http://localhost:3000
